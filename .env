NEXT_PUBLIC_API_URL=http://localhost:8080
# Audience of the Auth0 API this app calls. Must match the audience
# srtomy-api's SecurityConfig validates (and must exist as an API with
# this identifier in the srtommy.us.auth0.com tenant), otherwise the
# access token won't be a usable JWT for this API at all.
NEXT_PUBLIC_AUTH0_AUDIENCE=https://api.srtommy.com
